# Environment configuration for Multi Omics Factor Analysis Mofa
# Copy this file to .env and update with your secure values

# HMAC-SHA256 Audit Trail Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
AUDIT_SECRET_KEY=replace-with-secure-random-key

# LLM Provider (mock, ollama, claude, openai)
MODEL_PROVIDER=mock
